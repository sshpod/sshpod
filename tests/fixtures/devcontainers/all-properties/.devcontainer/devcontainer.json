{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "Complete parser fixture",
  "image": "alpine",
  "runArgs": ["--hostname", "development"],
  "overrideCommand": true,
  "shutdownAction": "stopContainer",
  "init": true,
  "privileged": false,
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  "workspaceFolder": "/workspace",
  "containerEnv": {"MODE": "dev"},
  "remoteEnv": {"EDITOR": "vi"},
  "containerUser": "root",
  "remoteUser": "root",
  "forwardPorts": [3000],
  "initializeCommand": "true",
  "onCreateCommand": ["true"],
  "updateContentCommand": {"one": "true", "two": ["true"]},
  "postCreateCommand": "true",
  "postStartCommand": "true",
  "postAttachCommand": "true",
  "waitFor": "postCreateCommand",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb",
    "gpu": {"cores": 1, "memory": "8gb"}
  },
  "customizations": {"vscode": {"extensions": ["rust-lang.rust-analyzer"]}},
  "secrets": {"TOKEN": {"description": "API token"}},
  "additionalProperties": {"referenceMetadata": true}
}
